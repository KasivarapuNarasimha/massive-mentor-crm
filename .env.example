# ===========================================
# Massive Mentor — Root Environment Example
# Copy this file to .env and fill in values
# ===========================================

# Database (used by both apps during local dev)
DATABASE_URL="postgresql://massivementor:massivementor_dev@localhost:5432/massivementor?schema=public"

# ===========================================
# Backend (apps/api)
# ===========================================
# JWT secret — use a long random string in production
JWT_SECRET="change-this-to-a-very-long-random-string-for-jwt-signing"

# AI Configuration (Milestone 4+)
AI_PROVIDER="groq"
GROQ_API_KEY="gsk-..."
GROQ_MODEL="llama-3.3-70b-versatile"

# Optional OpenAI configuration
# OPENAI_API_KEY="sk-..."
# OPENAI_MODEL="gpt-4o-mini"

# Optional: xAI / Grok (future)
# XAI_API_KEY="xai-..."

# Server
PORT=4000
NODE_ENV="development"
FRONTEND_URL="http://localhost:3000"

# ===========================================
# Frontend (apps/web)
# ===========================================
NEXT_PUBLIC_API_URL="http://localhost:4000/api"
