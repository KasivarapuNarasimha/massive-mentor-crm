# Backend Environment Variables
# Copy to .env in apps/api

DATABASE_URL="postgresql://massivementor:massivementor_dev@localhost:5432/massivementor?schema=public"

JWT_SECRET="change-this-to-a-very-long-random-string-for-jwt-signing"

# AI Configuration (Milestone 4+)
# Set AI_PROVIDER to "groq" (recommended) or "openai"
AI_PROVIDER="groq"
GROQ_API_KEY="gsk-..."
GROQ_MODEL="llama-3.3-70b-versatile"

# Optional: OpenAI configuration
# OPENAI_API_KEY="sk-..."
# OPENAI_MODEL="gpt-4o-mini"

PORT=4000
NODE_ENV="development"
FRONTEND_URL="http://localhost:3000"
