# Copy to server secrets store — never commit real values
NODE_ENV=production
PORT=4000
TRUST_PROXY=true

DATABASE_URL=postgresql://mm_prod:CHANGE_ME_STRONG@127.0.0.1:5432/massivementor?schema=public&connection_limit=20

# min 32 chars, unique per environment
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS

AI_PROVIDER=groq
GROQ_API_KEY=gsk_...
GROQ_MODEL=openai/gpt-oss-120b

# CORS allowlist — MUST include exact browser Origins (scheme+host, no path).
# credentials:true cannot use *. Code also allows https://*.massivementor.in.
FRONTEND_URL=https://crm.massivementor.in,https://app.massivementor.in,https://admin.massivementor.in,https://demo.massivementor.in
CORS_ORIGINS=https://crm.massivementor.in,https://app.massivementor.in,https://admin.massivementor.in,https://demo.massivementor.in
# Customer CRM URLs for login / password-reset links in emails (NOT localhost, NOT app.*)
APP_URL=https://crm.massivementor.in
CUSTOMER_APP_URL=https://crm.massivementor.in
ADMIN_APP_URL=https://admin.massivementor.in
WEBSITE_URL=https://massivementor.in
EMAIL_LOGO_URL=https://crm.massivementor.in/email-logo.png
SUPPORT_WEBSITE=https://massivementor.in
SUPPORT_EMAIL=team@massivementor.in
SUPPORT_WHATSAPP=+91 9182920047

SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@massivementor.in
SMTP_PASS=REPLACE
SMTP_FROM=Massive Mentor <noreply@massivementor.in>

BACKUP_ENCRYPTION_KEY=REPLACE_WITH_ANOTHER_LONG_RANDOM_SECRET
BACKUP_DIR=/var/lib/massivementor/backups
BACKUP_RETENTION_DAYS=30
BACKUP_NOTIFY_EMAIL=team@massivementor.in

PASSWORD_RESET_TTL_MINUTES=30
TRIAL_DAYS=3

# At-rest encryption for integration tokens (prefer dedicated key)
TOKEN_ENCRYPTION_KEY=REPLACE_WITH_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS

# Razorpay SaaS billing — use live keys only from secrets manager
RAZORPAY_KEY_ID=rzp_live_...
RAZORPAY_KEY_SECRET=REPLACE
RAZORPAY_WEBHOOK_SECRET=REPLACE

# AI cost controls (optional overrides)
# AI_DAILY_REQUEST_LIMIT=200
# AI_MONTHLY_REQUEST_LIMIT=3000
# AI_MONTHLY_COST_USD_LIMIT=50

# Public registration must stay off in production
# ALLOW_PUBLIC_REGISTER=false

# Optional: Redis for shared rate limits across PM2 instances.
# If unset, PostgreSQL-backed rate_limit_buckets table is used (also multi-instance safe).
# REDIS_URL=redis://127.0.0.1:6379/0
