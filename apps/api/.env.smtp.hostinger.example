# Hostinger SMTP — copy values into apps/api/.env and RESTART the API
# (tsx watch does not reload .env)

NODE_ENV=development

# Links in premium HTML emails — production values (never localhost on VPS):
# APP_URL=https://crm.massivementor.in
# CUSTOMER_APP_URL=https://crm.massivementor.in
# ADMIN_APP_URL=https://admin.massivementor.in
# WEBSITE_URL=https://massivementor.in
# SUPPORT_WEBSITE=https://massivementor.in
# SUPPORT_EMAIL=team@massivementor.in
# SUPPORT_WHATSAPP=+91 9182920047
# Local dev only:
APP_URL=http://localhost:3000
CUSTOMER_APP_URL=http://localhost:3000
ADMIN_APP_URL=http://localhost:3000
# EMAIL_LOGO_URL=https://crm.massivementor.in/email-logo.png
PASSWORD_RESET_TTL_MINUTES=30

# Hostinger mail
SMTP_HOST=smtp.hostinger.com
# SSL (recommended)
SMTP_PORT=465
SMTP_SECURE=true
# Or STARTTLS:
# SMTP_PORT=587
# SMTP_SECURE=false

# ---------------------------------------------------------------------------
# PRODUCTION RECOMMENDATION
# ---------------------------------------------------------------------------
# Create a dedicated mailbox in hPanel: noreply@yourdomain.com (or mailer@)
# AUTH + From MUST be the same mailbox Hostinger owns for that login.
# Hostinger rejects: AUTH as team@ + From noreply@  →  553 Sender not owned by user
#
# Using team@ as BOTH SMTP sender and Super Admin recipient means self-delivery
# (team@ → team@). Hostinger SMTP accepts it (250 queued) but the message may
# not show in Inbox (Spam / filters / local same-mailbox quirks). Gmail/others
# as recipients are fine.
#
# Recommended:
#   SMTP_USER=noreply@yourdomain.com
#   SMTP_PASS=<password of noreply mailbox>
#   SMTP_FROM=Massive Mentor <noreply@yourdomain.com>
# Recipients can still be Gmail, Outlook, Yahoo, company domains, or team@.
# ---------------------------------------------------------------------------

SMTP_USER=noreply@yourdomain.com
SMTP_PASS=your-noreply-mailbox-password
SMTP_FROM=Massive Mentor <noreply@yourdomain.com>

# DNS on your domain (already required for Hostinger Email):
#   MX  → mx1.hostinger.com / mx2.hostinger.com
#   SPF → v=spf1 include:_spf.mail.hostinger.com ~all
#   DKIM → hostingermail-a/b/c._domainkey CNAME → *.dkim.mail.hostinger.com
#   DMARC → _dmarc TXT v=DMARC1; p=none  (later p=quarantine)
