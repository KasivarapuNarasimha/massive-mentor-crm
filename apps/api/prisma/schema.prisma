generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  name          String?
  /// Optional workspace identity fields (searchable for lead assignment)
  phone         String?
  /// Employee / staff ID shown in Assign To search
  employeeCode  String?
  username      String?
  role          String    @default("sales_executive") // business-facing legacy role: admin | manager | sales_executive
  /// Platform-level role (not business membership). user | super_admin
  platformRole  String    @default("user")
  /// Soft-disable: cannot login
  isDisabled    Boolean   @default(false)
  /// Incremented on password change — JWT must match or session is revoked
  tokenVersion  Int       @default(0)
  /// Enterprise security: last successful login
  lastLoginAt   DateTime?
  lastLoginIp   String?
  /// Password lifecycle (MFA-ready security profile)
  passwordChangedAt DateTime?
  /// Future MFA flags — no OTP flow yet; columns reserved for 2FA without redesign
  mfaEnabled    Boolean   @default(false)
  mfaEnrolledAt DateTime?
  /// UI theme preference: light | dark | system (default)
  themePreference String  @default("system")
  /// Personal WhatsApp signature (appended when enabled)
  whatsappSignature String? @db.Text
  /// User preference: append signature when workspace auto-signature is on
  whatsappSignatureEnabled Boolean @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  passwordResetTokens PasswordResetToken[]
  sessions      UserSession[]
  loginEvents   LoginEvent[]
  profile       BusinessProfile?
  whatsappCaptionTemplates WhatsAppCaptionTemplate[]
  healthScores  HealthScore[]
  swotAnalyses  SWOTAnalysis[]
  roadmaps      Roadmap[]
  chatMessages       ChatMessage[]
  marketingContents  MarketingContent[]

  // Phase 3 - Core CRM (unified Contact supports Leads + Clients)
  contacts Contact[]
  deals    Deal[]
  tasks    Task[]
  meetings Meeting[]
  notes    Note[]
  documents Document[]

  activities Activity[]
  notifications Notification[]
  teamMemberships TeamMember[]
  integrations Integration[]
  aiGenerations AiGeneration[]
  aiRecommendations AiRecommendation[]
  aiRecommendationActions AiRecommendationAction[]

  // Field sales location tracking
  locationEvents       LocationEvent[]
  fieldWorkSessions    FieldWorkSession[]
  meetingAttendances   MeetingAttendance[]
  locationLiveState    UserLocationState?

  // AI Business OS — tenancy (Phase 1)
  ownedBusinesses  Business[]       @relation("BusinessOwner")
  businessMembers  BusinessMember[]
  auditLogs        AuditLog[]       @relation("AuditActor")

  invoices         Invoice[]
  expenses         Expense[]
  payments         Payment[]
  whatsappMessages WhatsAppMessage[]
  approvalRequestsCreated ApprovalRequest[] @relation("ApprovalRequester")
  approvalActions         ApprovalAction[]
}

/// Active login sessions (one row per device/browser). JWT carries session id (sid).
model UserSession {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessId      String?
  /// customer | admin | demo
  portal          String    @default("customer")
  /// Human-readable device label (e.g. Chrome on Windows)
  deviceName      String?
  browser         String?
  os              String?
  userAgent       String?   @db.Text
  ipAddress       String?
  /// IP-based approx location (city/region/country when available)
  locationLabel   String?
  countryCode     String?
  createdAt       DateTime  @default(now())
  lastActivityAt  DateTime  @default(now())
  expiresAt       DateTime
  revokedAt       DateTime?
  /// logout | force_logout | session_limit | password_change | disabled | expired | takeover
  revokedReason   String?
  /// Support-mode / MFA challenge flags (JSON) — future-ready
  meta            Json?

  @@index([userId, revokedAt])
  @@index([businessId, revokedAt])
  @@index([expiresAt])
  @@index([lastActivityAt])
}

/// Append-only security login history (not soft-deleted)
model LoginEvent {
  id            String   @id @default(cuid())
  userId        String?
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  businessId    String?
  sessionId     String?
  /// login | logout | failed_login | password_changed | new_device | force_logout | session_limit | mfa_challenge (future)
  eventType     String
  success       Boolean  @default(true)
  ipAddress     String?
  userAgent     String?  @db.Text
  deviceName    String?
  browser       String?
  os            String?
  locationLabel String?
  countryCode   String?
  /// Extra context (email attempted, reason, actor admin id)
  metadata      Json?
  createdAt     DateTime @default(now())

  @@index([userId, createdAt])
  @@index([businessId, createdAt])
  @@index([eventType, createdAt])
  @@index([ipAddress, createdAt])
}

/// One-time password reset tokens (store hash only — never raw token)
model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// SHA-256 hex of the raw token sent by email
  tokenHash String   @unique
  /// customer | admin — portal that requested the reset
  portal    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  requestIp String?
  userAgent String?

  @@index([userId, createdAt])
  @@index([expiresAt])
}

model BusinessProfile {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  businessName  String
  industry      String
  description   String   @db.Text
  employeeCount Int?
  /// ISO 4217 code: INR, USD, EUR, GBP, AED, SAR, SGD, AUD, CAD
  currency      String   @default("INR")
  /// Display range for selected currency (e.g. "₹5–₹25 Lakhs" or "$50K - $200K")
  annualRevenue String?
  stage         String?
  targetMarket  String?
  mainProduct   String?
  location      String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model HealthScore {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  overallScore  Int
  breakdown     Json
  insights      String[]
  calculatedAt  DateTime @default(now())
}

model SWOTAnalysis {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  strengths     String[]
  weaknesses    String[]
  opportunities String[]
  threats       String[]
  summary       String   @db.Text
  aiModel       String
  createdAt     DateTime @default(now())
}

model Roadmap {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  title         String
  days          Json
  generatedAt   DateTime @default(now())
  aiModel       String
}

model ChatMessage {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  role          String
  content       String   @db.Text
  createdAt     DateTime @default(now())
}

model MarketingContent {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // User-provided inputs at generation time
  businessName     String?
  industry         String?
  location         String?
  targetAudience   String?
  goal             String?

  // Generated content
  reelIdeas        String[] // 10 reel ideas
  adCopies         Json     // { facebook: string[], instagram: string[], google: string[] }
  hashtags         String[] // 20 hashtags
  marketingPlan    Json     // Week-by-week plan structure

  aiModel          String
  createdAt        DateTime @default(now())
}

// =====================================================
// AI Business OS — Tenancy (Phase 1)
// Business is the multi-tenant root. Dual-scope period:
// CRM still filters by userId; businessId is backfilled
// and attached for future template/config phases.
// =====================================================

model Business {
  id               String   @id @default(cuid())
  name             String
  slug             String?
  ownerUserId      String
  owner            User     @relation("BusinessOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  /// Installed IndustryTemplate (Phase 2)
  templateId       String?
  template         IndustryTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  templateVersion  Int?
  templateSlug     String?
  status           String   @default("active") // active | suspended | deleted
  settings         Json?

  // —— SaaS portal isolation (production multi-portal architecture) ——
  /// customer = real tenant workspace; demo = product demo only (never mix with customers)
  portalKind       String   @default("customer") // customer | demo
  isDemo           Boolean  @default(false)
  /// trial | starter | professional | enterprise (legacy: basic maps to starter)
  plan             String   @default("trial")
  /// trial | active | past_due | cancelled | expired | suspended | locked
  planStatus       String   @default("trial")
  trialEndsAt      DateTime?
  trialStartDate   DateTime?
  /// Configured trial length (default 3 days per SaaS product rules)
  trialDays        Int      @default(3)
  isTrial          Boolean  @default(true)
  /// Hard lock — CRM blocked until subscribe / Super Admin unlock
  isLocked         Boolean  @default(false)
  /// Days after subscriptionEndsAt before hard lock (renewal grace)
  gracePeriodDays  Int      @default(3)
  maxUsers         Int      @default(5)
  ownerPhone       String?
  gstNumber        String?
  country          String?  @default("IN")
  timezone         String?  @default("Asia/Kolkata")
  address          String?  @db.Text
  subscriptionEndsAt DateTime?
  setupFeePaid     Boolean  @default(false)
  billingEmail     String?
  /// White-label: { logoUrl, companyName, theme, customDomain, branding }
  whiteLabel       Json?
  licenseKey       String?
  /// trial | active | expired
  licenseStatus    String   @default("trial")
  suspendedAt      DateTime?
  suspendedReason  String?
  /// Usage counters snapshot (updated by platform jobs)
  usageSnapshot    Json?
  lastDemoResetAt  DateTime?

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  members   BusinessMember[]
  config    BusinessConfig?
  installs  TemplateInstall[]
  contacts  Contact[]
  deals     Deal[]
  tasks     Task[]
  meetings  Meeting[]
  auditLogs AuditLog[]
  locationEvents     LocationEvent[]
  fieldWorkSessions  FieldWorkSession[]
  meetingAttendances MeetingAttendance[]
  locationLiveStates UserLocationState[]
  platformInvoices   PlatformInvoice[]
  supportTickets     SupportTicket[]
  subscriptionEvents SubscriptionEvent[]
  backups            BackupRecord[]
  approvalWorkflows  ApprovalWorkflow[]
  approvalRequests   ApprovalRequest[]
  subscriptions      Subscription[]
  billingPayments    BillingPayment[]
  integrations       Integration[]
  leadAssignmentBatches LeadAssignmentBatch[]
  mediaFolders       MediaFolder[]
  mediaAssets        MediaAsset[]
  mediaKits          MediaKit[]
  mediaSendLogs      MediaSendLog[]
  mediaShareLinks    MediaShareLink[]
  mediaAssetEvents   MediaAssetEvent[]
  mediaAssetVersions MediaAssetVersion[]
  whatsappCaptionTemplates WhatsAppCaptionTemplate[]
  whatsappConversations WhatsAppConversation[]
  whatsappAssignRules   WhatsAppAssignRule[]
  whatsappSlaPolicies   WhatsAppSlaPolicy[]
  whatsappBroadcasts    WhatsAppBroadcast[]

  /// ERP Phase 2 — products / inventory / purchasing (additive)
  productCategories   ProductCategory[]
  products            Product[]
  warehouses          Warehouse[]
  inventoryBalances   InventoryBalance[]
  stockMovements      StockMovement[]
  vendors             Vendor[]
  purchaseOrders      PurchaseOrder[]
  purchaseOrderItems  PurchaseOrderItem[]
  goodsReceipts       GoodsReceipt[]
  goodsReceiptItems   GoodsReceiptItem[]
  purchaseReturns     PurchaseReturn[]
  purchaseReturnItems PurchaseReturnItem[]
  salesOrders         SalesOrder[]
  salesOrderItems     SalesOrderItem[]

  currentPlanId      String?
  currentPlan        SubscriptionPlan? @relation(fields: [currentPlanId], references: [id], onDelete: SetNull)

  @@index([ownerUserId])
  @@index([status])
  @@index([templateId])
  @@index([portalKind])
  @@index([isDemo])
  @@index([plan, planStatus])
  @@index([isLocked, trialEndsAt])
}

// ─── Enterprise Lead Assignment History ─────────────────────────────────────

/// One bulk / single assignment operation (history is append-only; edits audited)
model LeadAssignmentBatch {
  id          String   @id @default(cuid())
  /// Display sequence per workspace (Assignment #N)
  sequence    Int
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  /// Admin / actor who ran the assignment
  actorUserId String
  actorName   String?
  /// single | all_members
  mode        String
  /// ids | first_n | all_filtered | reassign | edit_move
  scope       String
  leadCount   Int
  memberCount Int
  /// Snapshot: [{ userId, name, email, count }]
  distribution Json
  filters     Json?
  notes       String?  @db.Text
  /// completed | partial
  status      String   @default("completed")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lines LeadAssignmentLine[]
  items LeadAssignmentItem[]

  @@unique([businessId, sequence])
  @@index([businessId, createdAt])
  @@index([actorUserId, createdAt])
}

/// Per-member counts within a batch
model LeadAssignmentLine {
  id         String @id @default(cuid())
  batchId    String
  batch      LeadAssignmentBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  userId     String
  userName   String?
  userEmail  String?
  leadCount  Int

  @@index([batchId])
  @@index([userId])
}

/// Per-lead ownership snapshot for a batch (enables edit / move without re-scanning CRM)
model LeadAssignmentItem {
  id        String @id @default(cuid())
  batchId   String
  batch     LeadAssignmentBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  contactId String
  /// Assignee after this batch (or after edit)
  userId    String

  @@unique([batchId, contactId])
  @@index([batchId, userId])
  @@index([contactId])
  @@index([userId])
}

// ─── WhatsApp caption templates (global + personal) ─────────────────────────

model WhatsAppCaptionTemplate {
  id              String   @id @default(cuid())
  businessId      String
  business        Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  /// null = workspace/global template (admin-managed); set = personal (owner only)
  userId          String?
  user            User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  body            String   @db.Text
  /// Sales | Support | Marketing | Follow-up | Payment | General
  category        String   @default("General")
  /// en | te | hi
  language        String   @default("en")
  isGlobal        Boolean  @default(false)
  sortOrder       Int      @default(0)
  useCount        Int      @default(0)
  lastUsedAt      DateTime?
  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([businessId, isGlobal, category])
  @@index([businessId, userId])
  @@index([businessId, lastUsedAt])
}

// ─── Media Library (brochures, catalogs, WhatsApp file sharing) ─────────────

model MediaFolder {
  id              String   @id @default(cuid())
  businessId      String
  business        Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name            String
  parentId        String?
  parent          MediaFolder?  @relation("MediaFolderTree", fields: [parentId], references: [id], onDelete: SetNull)
  children        MediaFolder[] @relation("MediaFolderTree")
  sortOrder       Int      @default(0)
  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  assets          MediaAsset[]

  @@index([businessId, parentId])
  @@index([businessId, name])
}

model MediaAsset {
  id              String   @id @default(cuid())
  businessId      String
  business        Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  folderId        String?
  folder          MediaFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  /// Display name
  name            String
  originalName    String
  mimeType        String
  /// image | pdf | video | document
  kind            String
  sizeBytes       Int
  /// local | s3
  storageProvider String   @default("local")
  storageKey      String
  /// Optional public CDN URL (S3/public)
  publicUrl       String?
  captionDefault  String?  @db.Text
  /// Searchable tags (brochure, pricing, catalog, …)
  tags            String[] @default([])
  downloadCount   Int      @default(0)
  whatsappSendCount Int    @default(0)
  emailSendCount  Int      @default(0)
  createdByUserId String
  deletedAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  /// SHA-256 hex of file content (duplicate detection)
  contentHash       String?
  /// Groups logical file versions (defaults to asset id on create)
  versionGroupId    String?
  versionNumber     Int      @default(1)
  isLatestVersion   Boolean  @default(true)
  /// pending | approved | rejected
  approvalStatus    String   @default("approved")
  approvedByUserId  String?
  approvedAt        DateTime?
  rejectionReason   String?
  /// Optional marketing offer / campaign expiry
  expiresAt         DateTime?
  archivedAt        DateTime?
  archiveReason     String?
  /// Last download / send / preview touch (smart collections + offline cache)
  lastUsedAt        DateTime?

  kitItems  MediaKitItem[]
  sendLogs  MediaSendLog[]
  favorites MediaFavorite[]
  events    MediaAssetEvent[]
  shareLinks MediaShareLink[]
  versions  MediaAssetVersion[]

  @@index([businessId, folderId, deletedAt])
  @@index([businessId, kind, deletedAt])
  @@index([businessId, name])
  @@index([businessId, createdAt])
  @@index([businessId, downloadCount])
  @@index([businessId, whatsappSendCount])
  @@index([businessId, contentHash])
  @@index([businessId, versionGroupId])
  @@index([businessId, approvalStatus, deletedAt])
  @@index([businessId, expiresAt])
  @@index([businessId, archivedAt])
  @@index([businessId, lastUsedAt])
}

/// Immutable version snapshots when a file is replaced
model MediaAssetVersion {
  id              String   @id @default(cuid())
  businessId      String
  business        Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  assetId         String
  asset           MediaAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  versionNumber   Int
  name            String
  originalName    String
  mimeType        String
  kind            String
  sizeBytes       Int
  storageKey      String
  storageProvider String   @default("local")
  contentHash     String?
  createdByUserId String
  note            String?
  createdAt       DateTime @default(now())

  @@unique([assetId, versionNumber])
  @@index([businessId, assetId])
  @@index([assetId, versionNumber])
}

/// Secure public share links (optional password + expiry)
model MediaShareLink {
  id              String   @id @default(cuid())
  businessId      String
  business        Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  assetId         String
  asset           MediaAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  /// Public token in URL (unguessable)
  token           String   @unique
  passwordHash    String?
  expiresAt       DateTime?
  maxDownloads    Int?
  downloadCount   Int      @default(0)
  createdByUserId String
  revokedAt       DateTime?
  createdAt       DateTime @default(now())

  @@index([businessId, assetId])
  @@index([token])
  @@index([expiresAt])
}

/// Full per-file activity timeline
model MediaAssetEvent {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  assetId     String
  asset       MediaAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  actorUserId String?
  actorName   String?
  /// uploaded | renamed | moved | tagged | favorited | unfavorited | sent | downloaded
  /// | archived | unarchived | approved | rejected | restored | shared | deleted | replaced | expired
  action      String
  detail      String?  @db.Text
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([businessId, assetId, createdAt])
  @@index([assetId, createdAt])
  @@index([businessId, action, createdAt])
}

/// Per-user favorites for quick access
model MediaFavorite {
  id        String   @id @default(cuid())
  businessId String
  userId    String
  assetId   String
  asset     MediaAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, assetId])
  @@index([businessId, userId])
  @@index([assetId])
}

/// Saved multi-file send packages (e.g. "CRM Introduction Kit")
model MediaKit {
  id              String   @id @default(cuid())
  businessId      String
  business        Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name            String
  description     String?
  captionTemplate String?  @db.Text
  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  items           MediaKitItem[]
  sendLogs        MediaSendLog[]

  @@index([businessId, name])
}

model MediaKitItem {
  id       String @id @default(cuid())
  kitId    String
  kit      MediaKit   @relation(fields: [kitId], references: [id], onDelete: Cascade)
  assetId  String
  asset    MediaAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  sortOrder Int   @default(0)

  @@unique([kitId, assetId])
  @@index([kitId])
}

/// Every media send (WhatsApp / future email/SMS) — never deleted
model MediaSendLog {
  id            String   @id @default(cuid())
  businessId    String
  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  assetId       String?
  asset         MediaAsset? @relation(fields: [assetId], references: [id], onDelete: SetNull)
  assetName     String
  kitId         String?
  kit           MediaKit? @relation(fields: [kitId], references: [id], onDelete: SetNull)
  sentByUserId  String
  sentByName    String?
  contactId     String?
  contactName   String?
  contactType   String?  // lead | client
  toPhone       String?
  toEmail       String?
  /// whatsapp | email | sms
  channel       String   @default("whatsapp")
  caption       String?  @db.Text
  /// pending | sent | delivered | read | failed
  status        String   @default("pending")
  waMessageId   String?
  error         String?
  metadata      Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([businessId, createdAt])
  @@index([sentByUserId, createdAt])
  @@index([contactId, createdAt])
  @@index([status, createdAt])
  @@index([waMessageId])
}

// =====================================================
// Platform (Super Admin) — customer metadata & ops
// Separate from customer CRM workspace data access paths.
// =====================================================

model PlatformInvoice {
  id            String   @id @default(cuid())
  businessId    String
  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  number        String
  kind          String   // setup | subscription | renewal | adjustment
  amount        Decimal  @db.Decimal(18, 2)
  currency      String   @default("INR")
  status        String   @default("open") // open | paid | void | overdue
  plan          String?
  periodStart   DateTime?
  periodEnd     DateTime?
  paidAt        DateTime?
  notes         String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([number])
  @@index([businessId, createdAt])
  @@index([status])
}

model SubscriptionEvent {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  actorUserId String?
  action      String   // activate | upgrade | downgrade | renew | cancel | trial_extend
  fromPlan    String?
  toPlan      String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([businessId, createdAt])
}

model SupportTicket {
  id            String   @id @default(cuid())
  businessId    String?
  business      Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  subject       String
  body          String   @db.Text
  status        String   @default("open") // open | in_progress | resolved | closed
  priority      String   @default("normal") // low | normal | high | urgent
  createdByUserId String?
  assignedToUserId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status, createdAt])
  @@index([businessId])
}

// =====================================================
// Phase 2 — Industry Template Engine (configuration-driven)
// Templates are data packages. No industry-specific code paths.
// =====================================================

model IndustryTemplate {
  id            String   @id @default(cuid())
  slug          String   @unique
  name          String
  description   String?  @db.Text
  category      String?  // catalog label only (not used in code switches)
  version       Int      @default(1)
  schemaVersion Int      @default(1)
  isPublished   Boolean  @default(true)
  isSystem      Boolean  @default(true)
  isMarketplace Boolean  @default(false)
  authorName    String?
  iconUrl       String?
  screenshots   Json?
  /// Full IndustryTemplateManifest JSON (modules, fields, pipelines, AI pack, etc.)
  manifest      Json
  packageHash   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  businesses Business[]
  installs   TemplateInstall[]

  @@index([isPublished])
  @@index([category])
}

/// Cloned + customized copy of a template for one business
model BusinessConfig {
  id              String   @id @default(cuid())
  businessId      String   @unique
  business        Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  schemaVersion   Int      @default(1)
  version         Int      @default(1) // bump on admin edit
  modules         Json     @default("[]")
  fields          Json     @default("[]")
  pipelines       Json     @default("[]")
  dashboards      Json     @default("[]")
  reports         Json     @default("[]")
  automations     Json     @default("[]")
  notifications   Json     @default("[]")
  aiPromptPack    Json     @default("{}")
  roles           Json     @default("[]")
  importMappings  Json     @default("[]")
  /// Role portals: menus, home, dashboards, actions (Phase 6)
  portals         Json     @default("[]")
  feedback        Json?
  plugins         Json?
  whiteLabelDefaults Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

/// Marketplace / onboarding install history
model TemplateInstall {
  id               String   @id @default(cuid())
  businessId       String
  business         Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  templateId       String
  template         IndustryTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  templateVersion  Int
  source           String   // seed | onboarding | marketplace | import | ensure_default
  installedByUserId String?
  createdAt        DateTime @default(now())

  @@index([businessId])
  @@index([templateId])
}

model BusinessMember {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Business role key: ceo | business_admin | sales_manager | sales_executive | marketing | finance | support | …
  role        String   @default("owner")
  /// Module access: { modules: string[], template?: string, customized?: boolean }
  permissions Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([businessId, userId])
  @@index([userId])
}

/// Catalog of CRM modules Super Admin can grant (future modules = new rows, no code change required for catalog UI)
model CrmModule {
  id          String   @id @default(cuid())
  /// Stable key: dashboard, leads, finance, billing, …
  key         String   @unique
  label       String
  description String?
  /// Frontend route prefix, e.g. /dashboard/finance
  routePrefix String?
  /// API path prefixes JSON string[], e.g. ["/api/finance"]
  apiPrefixes Json     @default("[]")
  category    String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  /// If true, always granted (profile, appearance) — still listed for transparency
  alwaysOn    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive, sortOrder])
}

/// Default module sets per portal/role template (CEO, Sales Executive, …)
model RolePermissionTemplate {
  id        String   @id @default(cuid())
  roleKey   String   @unique
  label     String
  /// JSON string[] of CrmModule.key values
  modules   Json     @default("[]")
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Append-only audit trail (Phase 1: login + tenancy events; expanded later)
model AuditLog {
  id          String   @id @default(cuid())
  businessId  String?
  business    Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  actorUserId String?
  actor       User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  action      String   // login | logout | register | create | update | delete | import | export | ai | config_change | ensure_business
  entityType  String?
  entityId    String?
  metadata    Json?
  ip          String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([businessId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
}

// =====================================================
// Phase 3: Core CRM Models
// Unified Contact model supports both Leads and Clients
// via `type` + flexible `status` for scalability.
// =====================================================

model Contact {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Tenant scope (nullable during dual-scope migration; backfilled by ensureDefaultBusiness)
  businessId      String?
  business        Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)

  // Unified type for Leads and Clients
  type            String   @default("lead") // "lead" | "client"
  // Flexible status for pipeline movement
  status          String   @default("new")  // e.g. new, contacted, qualified, proposal, won, lost, active, churned

  name            String
  email           String?
  phone           String?
  company         String?
  source          String?
  value           Decimal? @db.Decimal(18, 2) // potential or lifetime value (CRM only — not auto-Finance)
  /// not_revenue | expected | received — explicit intent for Finance; never auto-infer from value alone
  financialStatus String?
  description     String?  @db.Text
  lastContactedAt DateTime?

  // Future-ready fields for AI Business OS (Phase 3+)
  aiScore         Int?      // 0-100, AI-generated lead/client score
  priority        String?   // low | medium | high | urgent
  assignedTo      String?   // userId or team member (for future RBAC)
  nextFollowUp    DateTime?
  whatsapp        String?
  website         String?
  industry        String?
  tags            String[]  // simple scalable tagging; can evolve to join table later
  /// Industry/template custom attributes (Phase 3 FieldEngine). Empty object by default.
  customFields    Json      @default("{}")

  /// Soft delete (trash). Null = active. Lists exclude non-null by default.
  deletedAt       DateTime?
  deletedByUserId String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  deals     Deal[]
  tasks     Task[]
  meetings  Meeting[]
  salesOrders SalesOrder[]
  aiGenerations AiGeneration[]
  // notes and documents are fetched polymorphically via entityType/entityId (see crm.service)

  @@index([businessId])
  @@index([userId, type])
  @@index([deletedAt])
  @@index([businessId, deletedAt, type])
  @@index([businessId, status])
  @@index([businessId, type, status])
  @@index([assignedTo])
}

model AiGeneration {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  feature   String   // "whatsapp" | "email" | "proposal" | ...
  tone      String?
  language  String?
  content   String   @db.Text
  metadata  Json?

  createdAt DateTime @default(now())
}

/// Persistent AI Follow-up Engine recommendations (not ephemeral insights)
model AiRecommendation {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessId   String?

  /// contact | deal
  entityType   String
  entityId     String
  contactId    String?
  dealId       String?

  /// call | whatsapp | email | proposal | meeting | wait | high_priority | overdue | close_opportunity
  actionType   String
  /// Stable key so we do not re-spam the same advice after completion
  reasonCode   String
  fingerprint  String

  title        String
  reason       String   @db.Text
  /// high | medium | low
  priority     String   @default("medium")
  /// red | yellow | green
  urgency      String   @default("yellow")
  confidence   Float?
  /// Sort weight (higher = more urgent)
  rankScore    Int      @default(0)

  /// active | completed | dismissed | expired | superseded
  status       String   @default("active")

  metadata     Json?
  notifiedAt   DateTime?
  completedAt  DateTime?
  dismissedAt  DateTime?
  expiresAt    DateTime?
  lastSignalAt DateTime?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  actions      AiRecommendationAction[]

  @@unique([userId, fingerprint])
  @@index([userId, status, rankScore])
  @@index([userId, contactId, status])
  @@index([userId, entityType, entityId, status])
  @@index([userId, actionType, status])
}

/// History of user responses to AI recommendations
model AiRecommendationAction {
  id               String   @id @default(cuid())
  recommendationId String
  recommendation   AiRecommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// call | whatsapp | email | proposal | meeting | dismiss | complete | snooze
  actionTaken      String
  notes            String?
  createdAt        DateTime @default(now())

  @@index([userId, createdAt])
  @@index([recommendationId])
}

model Deal {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  businessId    String?
  business      Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)

  contactId     String?
  contact       Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  title         String
  value         Decimal? @db.Decimal(18, 2)
  stage         String   @default("lead") // lead, qualified, proposal, negotiation, closed_won, closed_lost
  expectedClose DateTime?
  probability   Int?     // 0-100 for AI forecasting
  notes         String?  @db.Text
  customFields  Json     @default("{}")

  tasks    Task[]
  meetings Meeting[]
  salesOrders SalesOrder[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([businessId])
  @@index([businessId, stage])
  @@index([contactId])
  @@index([userId, stage])
}

model Task {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  businessId  String?
  business    Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)

  contactId   String?
  contact     Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  dealId      String?
  deal        Deal?    @relation(fields: [dealId], references: [id], onDelete: SetNull)

  title       String
  description String?
  dueDate     DateTime?
  status      String   @default("todo") // todo, in_progress, done
  priority    String?  // low, medium, high
  /// Tenant custom field values (Settings → Custom Fields)
  customFields Json     @default("{}")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([businessId])
  @@index([businessId, status])
  @@index([userId, status])
  @@index([dueDate])
}

model Meeting {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  businessId  String?
  business    Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)

  contactId   String?
  contact     Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  dealId      String?
  deal        Deal?    @relation(fields: [dealId], references: [id], onDelete: SetNull)

  title       String
  scheduledAt DateTime
  durationMin Int?
  notes       String?  @db.Text
  outcome     String?
  /// Tenant custom field values (Settings → Custom Fields)
  customFields Json     @default("{}")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  attendances MeetingAttendance[]

  @@index([businessId])
}

// =====================================================
// Field Sales Location Tracking
// Precise GPS only when browser grants permission.
// IP fallback stores city/state/country only — never fabricated locality.
// =====================================================

/// Immutable audit trail of location-related events
model LocationEvent {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessId String?
  business   Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)

  /// login | logout | field_start | field_end | meeting_checkin | meeting_checkout | heartbeat
  eventType  String
  recordedAt DateTime @default(now())

  /// Precise coordinates — only when source=gps
  latitude   Float?
  longitude  Float?
  accuracyM  Float?
  /// meters/second from Geolocation API
  speedMps   Float?
  /// degrees 0-360
  headingDeg Float?
  /// Distance from previous GPS point in this session/day (km)
  segmentDistanceKm Float?
  /// gps | ip | unknown
  source     String   @default("unknown")

  fullAddress String?  @db.Text
  /// Area/locality — only from reverse-geocode of GPS (never from IP)
  locality    String?
  city        String?
  state       String?
  country     String?
  pincode     String?

  publicIp    String?
  userAgent   String?  @db.Text
  browser     String?
  device      String?
  os          String?

  meetingId       String?
  fieldSessionId  String?
  fieldSession    FieldWorkSession? @relation(fields: [fieldSessionId], references: [id], onDelete: SetNull)

  metadata Json?

  createdAt DateTime @default(now())

  @@index([userId, recordedAt])
  @@index([businessId, recordedAt])
  @@index([businessId, eventType, recordedAt])
  @@index([meetingId])
  @@index([fieldSessionId])
}

/// Open/closed field work day session
model FieldWorkSession {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessId String?
  business   Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)

  /// active | ended
  status     String   @default("active")
  startedAt  DateTime @default(now())
  endedAt    DateTime?

  startLat      Float?
  startLng      Float?
  startLocality String?
  startAddress  String?  @db.Text
  startSource   String?

  endLat      Float?
  endLng      Float?
  endLocality String?
  endAddress  String?  @db.Text
  endSource   String?

  /// Haversine km between start/end when both GPS (straight-line)
  distanceKm Float?
  /// Sum of GPS path segments during the session (route distance)
  totalTravelledKm Float?

  events LocationEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@index([businessId, startedAt])
}

/// Per-meeting check-in / check-out for a user
model MeetingAttendance {
  id         String   @id @default(cuid())
  meetingId  String
  meeting    Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessId String?
  business   Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)

  checkInAt       DateTime?
  checkInLat      Float?
  checkInLng      Float?
  checkInLocality String?
  checkInAddress  String?  @db.Text
  checkInSource   String?

  checkOutAt       DateTime?
  checkOutLat      Float?
  checkOutLng      Float?
  checkOutLocality String?
  checkOutAddress  String?  @db.Text
  checkOutSource   String?

  durationMin Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([meetingId, userId])
  @@index([userId, checkInAt])
  @@index([businessId, checkInAt])
}

/// Live snapshot for team map widget (one row per user)
model UserLocationState {
  id         String   @id @default(cuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessId String?
  business   Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)

  /// online | in_field | meeting | offline
  status          String   @default("offline")
  lastEventType   String?
  lastLocality    String?
  lastCity        String?
  lastState       String?
  lastCountry     String?
  lastFullAddress String?  @db.Text
  lastPincode     String?
  lastLat         Float?
  lastLng         Float?
  lastAccuracyM   Float?
  lastSpeedMps    Float?
  lastHeadingDeg  Float?
  /// gps | ip | unknown
  lastSource      String?
  /// stationary | moving | unknown
  movementStatus  String?  @default("unknown")
  /// Cumulative path distance for calendar day (km)
  travelledKmToday Float?  @default(0)
  /// YYYY-MM-DD local server day key for travelledKmToday reset
  travelDayKey    String?
  lastUpdatedAt   DateTime @default(now())

  activeFieldSessionId String?
  activeMeetingId      String?

  @@index([businessId, status])
  @@index([businessId, lastUpdatedAt])
}

model Note {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Polymorphic attachment - queried via entityType + entityId in service layer
  entityType  String   // "contact" | "deal" | "meeting" | ...
  entityId    String
  content     String   @db.Text

  createdAt   DateTime @default(now())

  @@index([userId, entityType, entityId])
  @@index([entityType, entityId])
}

model Document {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Polymorphic attachment - queried via entityType + entityId
  entityType  String?  // optional attachment to any entity
  entityId    String?
  title       String
  url         String?  // external link or future storage key
  mimeType    String?

  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
  @@index([entityType, entityId])
}

// =====================================================
// Batch 5: Automation, Integrations, Team, Reports, Activity
// =====================================================

model Activity {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  entityType  String   // "contact" | "deal" | "task" | ...
  entityId    String
  action      String   // "created" | "updated" | "email_sent" | "whatsapp_sent" | ...
  details     Json?    // e.g. { "oldStatus": "...", "newStatus": "..." }
  createdAt   DateTime @default(now())
}

model Notification {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  type        String   // "reminder" | "activity" | "integration"
  title       String
  message     String
  entityType  String?
  entityId    String?
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model Integration {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Tenant workspace that owns this connection (shared by all members for WhatsApp)
  businessId  String?
  business    Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)

  provider    String   // "whatsapp" | "gmail" | "google_calendar"
  config      Json     // tokens etc. (never return secrets to non-admin clients)
  isActive    Boolean  @default(true)
  /// Last successful credential validation timestamp
  lastValidatedAt DateTime?
  /// connected | verification_pending | invalid_token | not_connected | error
  status      String   @default("not_connected")
  lastError   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, provider])
  @@index([userId])
  @@index([businessId, provider])
}

model Team {
  id          String   @id @default(cuid())
  name        String
  ownerId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members     TeamMember[]
}

model TeamMember {
  id          String   @id @default(cuid())
  teamId      String
  team        Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        String   // "admin" | "manager" | "sales_executive"
  createdAt   DateTime @default(now())

  @@unique([teamId, userId])
}

// =====================================================
// Phase 4 — Finance (production)
// =====================================================

model Invoice {
  id          String    @id @default(cuid())
  businessId  String
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  number      String
  contactId   String?
  clientName  String?
  description String?   @db.Text
  amount      Decimal  @db.Decimal(18, 2)
  taxRate     Decimal  @default(0) @db.Decimal(8, 4)
  taxAmount   Decimal  @default(0) @db.Decimal(18, 2)
  total       Decimal  @db.Decimal(18, 2)
  currency    String    @default("INR")
  status      String    @default("draft") // draft | sent | paid | overdue | cancelled
  issueDate   DateTime  @default(now())
  dueDate     DateTime?
  paidAt      DateTime?
  notes       String?   @db.Text
  /// CRM link: deal | client | null (manual). Used for idempotent upsert + UI source label.
  sourceType  String?
  /// Deal id or Contact id when sourceType is set
  sourceId    String?
  /// Tenant custom field values (Settings → Custom Fields)
  customFields Json     @default("{}")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  payments    Payment[]
  /// Optional reverse link when Invoice was created from a Sales Order post
  salesOrders SalesOrder[]

  @@unique([businessId, number])
  /// One Finance revenue document per CRM source (prevents Deal+Client double count)
  @@unique([businessId, sourceType, sourceId])
  @@index([businessId, status])
  @@index([userId])
  @@index([dueDate])
  @@index([businessId, sourceType, sourceId])
}

model Expense {
  id          String   @id @default(cuid())
  businessId  String
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  category    String   @default("general")
  amount      Decimal  @db.Decimal(18, 2)
  taxAmount   Decimal  @default(0) @db.Decimal(18, 2)
  total       Decimal  @db.Decimal(18, 2)
  currency    String   @default("INR")
  expenseDate DateTime @default(now())
  vendor      String?
  notes       String?  @db.Text
  /// Tenant custom field values (Settings → Custom Fields)
  customFields Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([businessId, expenseDate])
  @@index([userId])
  @@index([category])
}

model Payment {
  id          String   @id @default(cuid())
  businessId  String
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoiceId   String?
  invoice     Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  amount      Decimal  @db.Decimal(18, 2)
  method      String   @default("bank") // bank | cash | upi | card | other
  reference   String?
  paidAt      DateTime @default(now())
  notes       String?  @db.Text
  /// Tenant custom field values (Settings → Custom Fields)
  customFields Json     @default("{}")
  createdAt   DateTime @default(now())

  @@index([businessId, paidAt])
  @@index([invoiceId])
  @@index([userId])
}

/// WhatsApp Conversation Center — one thread per phone within a business
model WhatsAppConversation {
  id                   String   @id @default(cuid())
  businessId           String
  business             Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  contactId            String?
  /// Digits-only E.164 without + (e.g. 919876543210)
  phone                String
  contactName          String?
  company              String?
  assignedToUserId     String?
  /// open | pending | follow_up | won | lost | closed
  status               String   @default("open")
  unreadCount          Int      @default(0)
  lastMessageAt        DateTime?
  lastMessagePreview   String?  @db.Text
  lastMessageDirection String?
  lastInboundAt        DateTime?
  lastOutboundAt       DateTime?
  /// Conversation labels e.g. Hot Lead, VIP, Payment Pending
  labels               String[] @default([])
  /// Hide from active inbox until this time
  snoozedUntil         DateTime?
  isSpam               Boolean  @default(false)
  isBlocked            Boolean  @default(false)
  /// Customer satisfaction 1-5 after close
  csatScore            Int?
  csatComment          String?
  csatSentAt           DateTime?
  csatRespondedAt      DateTime?
  closedAt             DateTime?
  firstResponseAt      DateTime?
  resolvedAt           DateTime?
  lastAgentReplyAt     DateTime?
  /// SLA breach flags
  slaBreachedL1        Boolean  @default(false)
  slaBreachedL2        Boolean  @default(false)
  /// AI summary JSON: requirement, budget, objections, nextAction, probability
  aiSummary            Json?
  aiSummaryAt          DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  messages             WhatsAppMessage[]
  pins                 WhatsAppConversationPin[]
  typing               WhatsAppTypingState[]

  @@unique([businessId, phone])
  @@index([businessId, lastMessageAt])
  @@index([businessId, assignedToUserId, lastMessageAt])
  @@index([businessId, status, lastMessageAt])
  @@index([businessId, unreadCount])
  @@index([businessId, snoozedUntil])
  @@index([businessId, isSpam])
  @@index([contactId])
}

/// Per-user pinned conversations (max 10 enforced in service)
model WhatsAppConversationPin {
  id             String   @id @default(cuid())
  businessId     String
  userId         String
  conversationId String
  conversation   WhatsAppConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())

  @@unique([userId, conversationId])
  @@index([userId, createdAt])
  @@index([businessId, userId])
}

/// Internal-only message reactions (never sent to customer)
model WhatsAppMessageReaction {
  id        String   @id @default(cuid())
  messageId String
  message   WhatsAppMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  @@unique([messageId, userId, emoji])
  @@index([messageId])
}

/// Soft typing indicators for team collab (+ optional customer flag)
model WhatsAppTypingState {
  id             String   @id @default(cuid())
  conversationId String
  conversation   WhatsAppConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  /// agent | customer
  actorType      String   @default("agent")
  isTyping       Boolean  @default(true)
  updatedAt      DateTime @updatedAt

  @@unique([conversationId, userId])
  @@index([conversationId, updatedAt])
}

/// Auto-assignment rules for new WhatsApp conversations
model WhatsAppAssignRule {
  id              String   @id @default(cuid())
  businessId      String
  business        Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name            String
  priority        Int      @default(100)
  isActive        Boolean  @default(true)
  /// { industry?, locationContains?, source?, tagsAny?, label? }
  conditions      Json     @default("{}")
  assignToUserId  String?
  /// Round-robin pool of user ids
  assignToUserIds String[] @default([])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([businessId, isActive, priority])
}

/// SLA policy for first-response escalation
model WhatsAppSlaPolicy {
  id                       String   @id @default(cuid())
  businessId               String
  business                 Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  isActive                 Boolean  @default(true)
  /// Minutes without agent reply after inbound → notify manager
  escalateManagerMinutes   Int      @default(15)
  /// Minutes without agent reply → notify business admin
  escalateAdminMinutes     Int      @default(30)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@unique([businessId])
}

/// Broadcast campaigns (template-based bulk WhatsApp)
model WhatsAppBroadcast {
  id              String   @id @default(cuid())
  businessId      String
  business        Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name            String
  /// Free-text body or template name
  body            String   @db.Text
  templateName    String?
  /// draft | sending | completed | failed | cancelled
  status          String   @default("draft")
  /// { type: lead|client|all, status?, tags?, industry?, location? }
  audienceFilter  Json     @default("{}")
  createdByUserId String
  totalRecipients Int      @default(0)
  sentCount       Int      @default(0)
  failedCount     Int      @default(0)
  deliveredCount  Int      @default(0)
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  items           WhatsAppBroadcastItem[]

  @@index([businessId, createdAt])
  @@index([businessId, status])
}

model WhatsAppBroadcastItem {
  id           String   @id @default(cuid())
  broadcastId  String
  broadcast    WhatsAppBroadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  contactId    String?
  phone        String
  status       String   @default("pending") // pending | sent | delivered | failed
  error        String?
  waMessageId  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([broadcastId, status])
}

/// WhatsApp Cloud API conversation history (real send + inbound + internal notes)
model WhatsAppMessage {
  id            String   @id @default(cuid())
  businessId    String?
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  contactId     String?
  conversationId String?
  conversation  WhatsAppConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  to            String
  from          String?
  body          String   @db.Text
  direction     String   // outbound | inbound | internal
  status        String   @default("queued") // queued | sent | delivered | read | failed
  /// text | image | video | document | audio | note | system
  messageType   String   @default("text")
  mediaUrl      String?
  mediaMime     String?
  mediaName     String?
  /// Speech-to-text for voice notes
  transcript    String?  @db.Text
  /// Private note — never sent to customer
  isInternal    Boolean  @default(false)
  waMessageId   String?
  templateName  String?
  error         String?
  metadata      Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  reactions     WhatsAppMessageReaction[]

  @@index([userId, createdAt])
  @@index([contactId, createdAt])
  @@index([waMessageId])
  @@index([businessId, createdAt])
  @@index([conversationId, createdAt])
  @@index([businessId, isInternal, createdAt])
}

// =====================================================
// Enterprise Backup & Restore
// =====================================================

/// Encrypted backup artifact metadata (file stored on disk under BACKUP_DIR)
model BackupRecord {
  id               String   @id @default(cuid())
  /// full | business
  type             String
  /// Set when type=business
  businessId       String?
  business         Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  /// pending | running | completed | failed | verified | deleted
  status           String   @default("pending")
  /// manual | daily | weekly | monthly | schedule
  trigger          String   @default("manual")
  fileName         String?
  /// Relative path under backup root (never expose absolute path to non-admin)
  storageKey       String?
  sizeBytes        BigInt   @default(0)
  /// SHA-256 of ciphertext (or plaintext if unencrypted)
  checksumSha256   String?
  encrypted        Boolean  @default(true)
  /// AES-256-GCM IV (hex)
  encryptionIv     String?
  /// AES-256-GCM auth tag (hex)
  encryptionTag    String?
  compression      String   @default("gzip")
  /// 0–100
  progress         Int      @default(0)
  rowCounts        Json?
  errorMessage     String?  @db.Text
  verifiedAt       DateTime?
  verificationOk   Boolean?
  createdByUserId  String?
  /// For failure notifications
  notifyEmail      String?
  expiresAt        DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  restores BackupRestoreRecord[]

  @@index([type, status, createdAt])
  @@index([businessId, createdAt])
  @@index([trigger, createdAt])
  @@index([status, createdAt])
}

model BackupRestoreRecord {
  id                    String   @id @default(cuid())
  backupId              String
  backup                BackupRecord @relation(fields: [backupId], references: [id], onDelete: Cascade)
  /// pending_confirm | running | completed | failed | cancelled
  status                String   @default("pending_confirm")
  /// full | business
  scope                 String
  businessId            String?
  /// One-time confirmation token (hashed)
  confirmationTokenHash String?
  confirmationExpiresAt DateTime?
  confirmedAt           DateTime?
  verifiedBeforeRestore Boolean  @default(false)
  progress              Int      @default(0)
  actorUserId           String?
  errorMessage          String?  @db.Text
  startedAt             DateTime?
  completedAt           DateTime?
  metadata              Json?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([backupId, createdAt])
  @@index([status, createdAt])
  @@index([actorUserId, createdAt])
}

/// Automatic backup cadence (Super Admin managed)
model BackupSchedule {
  id            String   @id @default(cuid())
  /// daily | weekly | monthly
  cadence       String
  enabled       Boolean  @default(true)
  /// 0–23 UTC
  hourUtc       Int      @default(2)
  /// 0–6 for weekly (Sun=0)
  dayOfWeek     Int?
  /// 1–28 for monthly
  dayOfMonth    Int?
  /// full | business_all (each customer business)
  backupType    String   @default("full")
  retentionDays Int      @default(30)
  lastRunAt     DateTime?
  nextRunAt     DateTime?
  lastError     String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([cadence])
  @@index([enabled, nextRunAt])
}

// =====================================================
// Approval Workflow Engine (enterprise multi-level)
// Types: discount | proposal | invoice | expense | leave | purchase | custom
// Status: pending | approved | rejected | cancelled
// =====================================================

model ApprovalWorkflow {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  /// discount | proposal | invoice | expense | leave | purchase | custom
  type        String
  name        String
  description String?  @db.Text
  enabled     Boolean  @default(true)
  /// e.g. { minAmount: 10000, currency: "INR", stages: ["proposal"] }
  rules       Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  steps    ApprovalStepDef[]
  requests ApprovalRequest[]

  @@unique([businessId, type, name])
  @@index([businessId, type, enabled])
}

/// Ordered approval levels for a workflow (multi-level)
model ApprovalStepDef {
  id          String   @id @default(cuid())
  workflowId  String
  workflow    ApprovalWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  /// 1-based level order
  level       Int
  name        String?
  /// Approver role (business_admin, finance, manager, ceo, …) OR empty if userId set
  approverRole String?
  /// Specific approver user (optional override)
  approverUserId String?
  /// all = every approver at level must approve; any = first approval advances
  mode        String   @default("any")
  createdAt   DateTime @default(now())

  @@unique([workflowId, level])
  @@index([workflowId])
}

model ApprovalRequest {
  id             String   @id @default(cuid())
  businessId     String
  business       Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  workflowId     String?
  workflow       ApprovalWorkflow? @relation(fields: [workflowId], references: [id], onDelete: SetNull)
  /// discount | proposal | invoice | expense | leave | purchase | custom
  type           String
  /// Linked CRM entity (invoice, expense, deal, …)
  entityType     String?
  entityId       String?
  title          String
  description    String?  @db.Text
  /// Amount threshold context (optional)
  amount         Decimal? @db.Decimal(18, 2)
  currency       String?  @default("INR")
  /// pending | approved | rejected | cancelled
  status         String   @default("pending")
  currentLevel   Int      @default(1)
  maxLevel       Int      @default(1)
  requestedById  String
  requestedBy    User     @relation("ApprovalRequester", fields: [requestedById], references: [id], onDelete: Cascade)
  metadata       Json?
  decidedAt      DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  actions ApprovalAction[]

  @@index([businessId, status, createdAt])
  @@index([businessId, type, status])
  @@index([requestedById, createdAt])
  @@index([entityType, entityId])
}

model ApprovalAction {
  id          String   @id @default(cuid())
  requestId   String
  request     ApprovalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  actorUserId String
  actor       User     @relation(fields: [actorUserId], references: [id], onDelete: Cascade)
  level       Int
  /// submit | approve | reject | cancel | comment
  action      String
  comment     String?  @db.Text
  createdAt   DateTime @default(now())

  @@index([requestId, createdAt])
  @@index([actorUserId, createdAt])
}

// =====================================================
// SaaS Billing — Subscription Plans, Subscriptions, Payments (Razorpay)
// Separate from CRM finance Payment (customer invoices inside a tenant).
// =====================================================

model SubscriptionPlan {
  id            String   @id @default(cuid())
  /// starter_monthly | starter_annual | professional_monthly | ...
  code          String   @unique
  name          String
  description   String?  @db.Text
  /// monthly | annual
  billingCycle  String
  price         Decimal  @db.Decimal(18, 2)
  currency      String   @default("INR")
  maxUsers      Int      @default(5)
  storageGb     Int      @default(5)
  /// Feature flags / bullet list for UI
  features      Json     @default("[]")
  displayOrder  Int      @default(0)
  /// active | archived
  status        String   @default("active")
  razorpayPlanId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  subscriptions Subscription[]
  payments      BillingPayment[]
  businesses    Business[]

  @@index([status, displayOrder])
  @@index([billingCycle])
}

model Subscription {
  id             String   @id @default(cuid())
  businessId     String
  business       Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  planId         String?
  plan           SubscriptionPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)
  /// trial | active | past_due | expired | cancelled | suspended
  status         String   @default("trial")
  startDate      DateTime @default(now())
  endDate        DateTime?
  renewalDate    DateTime?
  autoRenew      Boolean  @default(false)
  paymentId      String?
  createdById    String?
  trialStartDate DateTime?
  trialEndDate   DateTime?
  notes          String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  payments BillingPayment[]

  @@index([businessId, status])
  @@index([endDate])
  @@index([trialEndDate])
}

/// SaaS / Razorpay payments (platform billing) — not CRM client invoice payments
model BillingPayment {
  id                 String   @id @default(cuid())
  businessId         String
  business           Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId             String?
  planId             String?
  plan               SubscriptionPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)
  subscriptionId     String?
  subscription       Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  couponId           String?
  coupon             BillingCoupon? @relation(fields: [couponId], references: [id], onDelete: SetNull)
  /// monthly | annual
  billingCycle       String?
  /// Total charged (incl. GST)
  amount             Decimal  @db.Decimal(18, 2)
  gst                Decimal  @default(0) @db.Decimal(18, 2)
  discountAmount     Decimal  @default(0) @db.Decimal(18, 2)
  currency           String   @default("INR")
  razorpayOrderId    String?
  razorpayPaymentId  String?  @unique
  razorpaySignature  String?
  invoiceNumber      String?
  invoiceUrl         String?
  /// Relative path under BACKUP_DIR/invoices or absolute
  invoicePdfPath     String?
  /// created | authorized | paid | failed | refunded | cancelled
  status             String   @default("created")
  /// checkout | upgrade | downgrade | renewal | retry
  purpose            String   @default("checkout")
  metadata           Json?
  paidAt             DateTime?
  activatedAt        DateTime?
  /// Source of truth for activation: webhook | admin | system
  activatedBy        String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([invoiceNumber])
  @@index([businessId, createdAt])
  @@index([razorpayOrderId])
  @@index([status])
}

/// Idempotent Razorpay webhook processing
model RazorpayWebhookEvent {
  id            String   @id @default(cuid())
  /// Razorpay event id (x-razorpay-event-id) or hash of body
  eventId       String   @unique
  eventType     String
  payload       Json
  processed     Boolean  @default(false)
  processedAt   DateTime?
  result        String?
  error         String?  @db.Text
  createdAt     DateTime @default(now())

  @@index([eventType, createdAt])
  @@index([processed, createdAt])
}

/// Discount coupons (percentage or flat)
model BillingCoupon {
  id              String   @id @default(cuid())
  code            String   @unique
  /// percent | flat
  discountType    String
  discountValue   Decimal  @db.Decimal(18, 4)
  currency        String   @default("INR")
  maxUses         Int?
  usedCount       Int      @default(0)
  minAmount       Decimal? @db.Decimal(18, 2)
  /// Optional plan codes JSON array
  applicablePlans Json?
  expiresAt       DateTime?
  /// active | disabled
  status          String   @default("active")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  payments    BillingPayment[]
  redemptions CouponRedemption[]

  @@index([status, expiresAt])
}

model CouponRedemption {
  id         String   @id @default(cuid())
  couponId   String
  coupon     BillingCoupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  businessId String
  paymentId  String?
  userId     String?
  createdAt  DateTime @default(now())

  @@index([couponId, createdAt])
  @@index([businessId])
}

/// Atomic counters for finance + SaaS invoice numbers (globally unique keys)
model InvoiceSequence {
  id         String   @id @default(cuid())
  /// e.g. finance:{businessId}:2026 | saas:global:2026
  key        String   @unique
  prefix     String
  lastValue  Int      @default(0)
  businessId String?
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())

  @@index([businessId])
}

/// Per-request AI usage for quotas / cost control (business-scoped)
model AiUsageEvent {
  id         String   @id @default(cuid())
  businessId String?
  userId     String
  /// mentor | lead_score | proposal | forecast | meeting_summary | ...
  feature    String
  tokens     Int      @default(0)
  costUsd    Decimal  @default(0) @db.Decimal(12, 6)
  model      String?
  success    Boolean  @default(true)
  /// YYYY-MM-DD for daily rollups
  dayKey     String
  /// YYYY-MM for monthly rollups
  monthKey   String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([businessId, dayKey])
  @@index([businessId, monthKey])
  @@index([userId, dayKey])
  @@index([feature, createdAt])
}

// =====================================================
// ERP Phase 2 — Products, Inventory, Vendors, Purchases
// Additive only. All rows require non-null businessId.
// Stock source of truth = StockMovement; InventoryBalance is materialized.
// Do NOT duplicate Invoice / Payment / Expense / P&L.
// =====================================================

model ProductCategory {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  parentId   String?
  parent     ProductCategory?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children   ProductCategory[] @relation("CategoryTree")
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  products   Product[]

  @@unique([businessId, name])
  @@index([businessId])
  @@index([parentId])
}

model Product {
  id              String   @id @default(cuid())
  businessId      String
  business        Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  categoryId      String?
  category        ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  sku             String
  name            String
  description     String?  @db.Text
  /// pcs | kg | hrs | box | ...
  unit            String   @default("pcs")
  /// goods | service
  type            String   @default("goods")
  trackInventory  Boolean  @default(true)
  sellingPrice    Decimal? @db.Decimal(18, 2)
  costPrice       Decimal? @db.Decimal(18, 2)
  taxRate         Decimal? @db.Decimal(8, 4)
  reorderLevel    Decimal? @db.Decimal(18, 4)
  isActive        Boolean  @default(true)
  /// Tenant custom field values (Settings → Custom Fields)
  customFields    Json     @default("{}")
  createdByUserId String?
  deletedAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  balances            InventoryBalance[]
  movements           StockMovement[]
  purchaseOrderItems  PurchaseOrderItem[]
  goodsReceiptItems   GoodsReceiptItem[]
  purchaseReturnItems PurchaseReturnItem[]
  salesOrderItems     SalesOrderItem[]

  @@unique([businessId, sku])
  @@index([businessId, name])
  @@index([businessId, isActive])
  @@index([categoryId])
  @@index([businessId, deletedAt])
}

model Warehouse {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  code       String
  name       String
  address    String?  @db.Text
  isDefault  Boolean  @default(false)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  balances            InventoryBalance[]
  movements           StockMovement[]
  goodsReceipts       GoodsReceipt[]
  purchaseReturns     PurchaseReturn[]
  salesOrders         SalesOrder[]

  @@unique([businessId, code])
  @@index([businessId])
  @@index([businessId, isActive])
}

/// Materialized on-hand qty per product × warehouse (updated with StockMovement in same TX)
model InventoryBalance {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  qtyOnHand   Decimal  @default(0) @db.Decimal(18, 4)
  qtyReserved Decimal  @default(0) @db.Decimal(18, 4)
  avgCost     Decimal? @db.Decimal(18, 4)
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@unique([businessId, productId, warehouseId])
  @@index([businessId, warehouseId])
  @@index([businessId, productId])
}

/// Append-only stock ledger — source of truth for inventory
model StockMovement {
  id              String   @id @default(cuid())
  businessId      String
  business        Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  productId       String
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouseId     String
  warehouse       Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  /// purchase_in | sale_out | adjustment | transfer_in | transfer_out | return_in | return_out | opening
  type            String
  /// Signed quantity: + inbound, − outbound
  qty             Decimal  @db.Decimal(18, 4)
  unitCost        Decimal? @db.Decimal(18, 4)
  /// purchase_order | goods_receipt | purchase_return | invoice | manual | transfer
  referenceType   String?
  referenceId     String?
  notes           String?  @db.Text
  createdByUserId String
  createdAt       DateTime @default(now())

  @@index([businessId, productId, createdAt])
  @@index([businessId, warehouseId, createdAt])
  @@index([businessId, referenceType, referenceId])
  @@index([businessId, type, createdAt])
}

model Vendor {
  id              String   @id @default(cuid())
  businessId      String
  business        Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name            String
  email           String?
  phone           String?
  company         String?
  gstNumber       String?
  address         String?  @db.Text
  paymentTerms    String?
  notes           String?  @db.Text
  isActive        Boolean  @default(true)
  /// Tenant custom field values (Settings → Custom Fields)
  customFields    Json     @default("{}")
  createdByUserId String?
  deletedAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  purchaseOrders  PurchaseOrder[]
  purchaseReturns PurchaseReturn[]

  @@index([businessId, name])
  @@index([businessId, isActive])
  @@index([businessId, deletedAt])
}

model PurchaseOrder {
  id                String   @id @default(cuid())
  businessId        String
  business          Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  vendorId          String
  vendor            Vendor   @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  number            String
  /// draft | sent | partial | received | cancelled | closed
  status            String   @default("draft")
  orderDate         DateTime @default(now())
  expectedDate      DateTime?
  currency          String   @default("INR")
  subtotal          Decimal  @default(0) @db.Decimal(18, 2)
  taxAmount         Decimal  @default(0) @db.Decimal(18, 2)
  total             Decimal  @default(0) @db.Decimal(18, 2)
  notes             String?  @db.Text
  createdByUserId   String
  approvedAt        DateTime?
  approvedByUserId  String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  items         PurchaseOrderItem[]
  goodsReceipts GoodsReceipt[]
  returns       PurchaseReturn[]

  @@unique([businessId, number])
  @@index([businessId, status])
  @@index([businessId, vendorId])
  @@index([businessId, orderDate])
}

model PurchaseOrderItem {
  id              String   @id @default(cuid())
  businessId      String
  business        Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId       String
  product         Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  description     String?
  qtyOrdered      Decimal  @db.Decimal(18, 4)
  qtyReceived     Decimal  @default(0) @db.Decimal(18, 4)
  unitCost        Decimal  @db.Decimal(18, 2)
  taxRate         Decimal  @default(0) @db.Decimal(8, 4)
  lineTotal       Decimal  @db.Decimal(18, 2)
  sortOrder       Int      @default(0)

  goodsReceiptItems GoodsReceiptItem[]

  @@index([purchaseOrderId])
  @@index([businessId, productId])
}

model GoodsReceipt {
  id              String   @id @default(cuid())
  businessId      String
  business        Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  warehouseId     String
  warehouse       Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  number          String
  /// draft | posted | cancelled
  status          String   @default("draft")
  receivedAt      DateTime @default(now())
  notes           String?  @db.Text
  createdByUserId String
  postedAt        DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  items   GoodsReceiptItem[]
  returns PurchaseReturn[]

  @@unique([businessId, number])
  @@index([businessId, status])
  @@index([businessId, purchaseOrderId])
  @@index([warehouseId])
}

model GoodsReceiptItem {
  id                  String   @id @default(cuid())
  businessId          String
  business            Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  goodsReceiptId      String
  goodsReceipt        GoodsReceipt @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  purchaseOrderItemId String
  purchaseOrderItem   PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id], onDelete: Restrict)
  productId           String
  product             Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  qtyReceived         Decimal  @db.Decimal(18, 4)
  unitCost            Decimal  @db.Decimal(18, 2)

  @@index([goodsReceiptId])
  @@index([businessId, productId])
  @@index([purchaseOrderItemId])
}

model PurchaseReturn {
  id              String   @id @default(cuid())
  businessId      String
  business        Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  vendorId        String
  vendor          Vendor   @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  goodsReceiptId  String?
  goodsReceipt    GoodsReceipt? @relation(fields: [goodsReceiptId], references: [id], onDelete: SetNull)
  warehouseId     String
  warehouse       Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  number          String
  /// draft | posted | cancelled
  status          String   @default("draft")
  reason          String?  @db.Text
  createdByUserId String
  postedAt        DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  items PurchaseReturnItem[]

  @@unique([businessId, number])
  @@index([businessId, status])
  @@index([businessId, vendorId])
  @@index([warehouseId])
}

model PurchaseReturnItem {
  id               String   @id @default(cuid())
  businessId       String
  business         Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  purchaseReturnId String
  purchaseReturn   PurchaseReturn @relation(fields: [purchaseReturnId], references: [id], onDelete: Cascade)
  productId        String
  product          Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  qty              Decimal  @db.Decimal(18, 4)
  unitCost         Decimal  @db.Decimal(18, 2)

  @@index([purchaseReturnId])
  @@index([businessId, productId])
}

// =====================================================
// ERP Phase 2.5 — Sales Orders (CRM Deal → stock out → Finance)
// Additive only. Invoice/Payment reused via sourceType=sales_order.
// =====================================================

model SalesOrder {
  id              String   @id @default(cuid())
  businessId      String
  business        Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  dealId          String?
  deal            Deal?    @relation(fields: [dealId], references: [id], onDelete: SetNull)
  contactId       String?
  contact         Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  warehouseId     String
  warehouse       Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  number          String
  /// draft | confirmed | posting | posted | cancelled
  status          String   @default("draft")
  orderDate       DateTime @default(now())
  currency        String   @default("INR")
  subtotal        Decimal  @default(0) @db.Decimal(18, 2)
  taxAmount       Decimal  @default(0) @db.Decimal(18, 2)
  total           Decimal  @default(0) @db.Decimal(18, 2)
  notes           String?  @db.Text
  invoiceId       String?
  invoice         Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  createdByUserId String
  postedAt        DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  items SalesOrderItem[]

  @@unique([businessId, number])
  @@index([businessId, status])
  @@index([businessId, dealId])
  @@index([businessId, contactId])
  @@index([warehouseId])
  @@index([invoiceId])
}

model SalesOrderItem {
  id            String   @id @default(cuid())
  businessId    String
  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  salesOrderId  String
  salesOrder    SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  description   String?
  qtyOrdered    Decimal  @db.Decimal(18, 4)
  qtyFulfilled  Decimal  @default(0) @db.Decimal(18, 4)
  unitPrice     Decimal  @db.Decimal(18, 2)
  taxRate       Decimal  @default(0) @db.Decimal(8, 4)
  lineTotal     Decimal  @db.Decimal(18, 2)
  sortOrder     Int      @default(0)

  @@index([salesOrderId])
  @@index([businessId, productId])
}
